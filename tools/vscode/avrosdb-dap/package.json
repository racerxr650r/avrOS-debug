{
  "name": "avrosdb-dap",
  "displayName": "avrOSdb (DAP)",
  "description": "Debug AVR-Dx targets in VS Code via `avrOSdb --dap` — one F5 starts the server and attaches, with an avrOS activity-bar view for state machines, events, and queues.",
  "version": "0.3.0",
  "publisher": "avrOS",
  "engines": { "vscode": "^1.66.0" },
  "categories": ["Debuggers"],
  "main": "./extension.js",
  "activationEvents": [
    "onDebugResolve:avrosdb",
    "onDebugInitialConfigurations",
    "onView:avrosStateMachines",
    "onView:avrosEvents",
    "onView:avrosQueues",
    "onView:avrosVariables",
    "onView:avrosCallStack",
    "onView:avrosBreakpoints"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "avrosDebug",
          "title": "avrOS",
          "icon": "media/avros.svg"
        }
      ]
    },
    "views": {
      "avrosDebug": [
        { "id": "avrosVariables", "name": "Variables" },
        { "id": "avrosCallStack", "name": "Call Stack" },
        { "id": "avrosBreakpoints", "name": "Breakpoints" },
        { "id": "avrosStateMachines", "name": "State Machines" },
        { "id": "avrosEvents", "name": "Events" },
        { "id": "avrosQueues", "name": "Queues" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "avrosStateMachines",
        "contents": "No avrOS debug session.\nStart debugging (F5) with the avrOSdb (--dap) configuration to inspect the target's avrOS state machines, events, and queues.\n[Start Debugging](command:workbench.action.debug.start)"
      }
    ],
    "commands": [
      {
        "command": "avrosdb.refresh",
        "title": "avrOS: Refresh Debug View",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        { "command": "avrosdb.refresh", "when": "view == avrosStateMachines", "group": "navigation" },
        { "command": "avrosdb.refresh", "when": "view == avrosEvents", "group": "navigation" },
        { "command": "avrosdb.refresh", "when": "view == avrosQueues", "group": "navigation" },
        { "command": "avrosdb.refresh", "when": "view == avrosVariables", "group": "navigation" },
        { "command": "avrosdb.refresh", "when": "view == avrosCallStack", "group": "navigation" }
      ]
    },
    "debuggers": [
      {
        "type": "avrosdb",
        "label": "avrOSdb (DAP)",
        "configurationAttributes": {
          "launch": {
            "required": ["serial", "elf"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the avrOSdb binary to launch.",
                "default": "${workspaceFolder}/build/avrOSdb"
              },
              "serial": {
                "type": "string",
                "description": "Serial device connected to the target's UPDI pin.",
                "default": "/dev/ttyAMA2"
              },
              "elf": {
                "type": "string",
                "description": "ELF to debug (its DWARF drives source/variables).",
                "default": "${workspaceFolder}/firmware.elf"
              },
              "port": {
                "type": "number",
                "description": "TCP port for the spawned avrOSdb --dap server.",
                "default": 1234
              },
              "host": {
                "type": "string",
                "description": "Host to connect to the spawned server on.",
                "default": "127.0.0.1"
              },
              "extraArgs": {
                "type": "array",
                "description": "Extra avrOSdb flags (e.g. [\"--baud\",\"230400\"]).",
                "items": { "type": "string" },
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the spawned server.",
                "default": "${workspaceFolder}"
              }
            }
          },
          "attach": {
            "properties": {
              "host": {
                "type": "string",
                "description": "Host the avrOSdb --dap server listens on.",
                "default": "127.0.0.1"
              },
              "port": {
                "type": "number",
                "description": "TCP port of the avrOSdb --dap server.",
                "default": 1234
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "avrosdb",
            "request": "launch",
            "name": "Debug with avrOSdb (--dap)",
            "program": "${workspaceFolder}/build/avrOSdb",
            "serial": "/dev/ttyAMA2",
            "elf": "${workspaceFolder}/firmware.elf",
            "port": 1234
          },
          {
            "type": "avrosdb",
            "request": "attach",
            "name": "Attach to running avrOSdb (--dap)",
            "host": "127.0.0.1",
            "port": 1234
          }
        ]
      }
    ]
  }
}
